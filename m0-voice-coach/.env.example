ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
PORT=3000

# Owner traffic tracker (optional). A free Redis at upstash.com (REST type);
# both values come from the Upstash dashboard. Without these the tracker
# stays off and the site behaves exactly as without it.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# LLM coaching (optional). Without these, M1 uses the built-in
# deterministic coach. All keys stay server-side — never in browser code.
# COACH_PROVIDER=openrouter
# COACH_MODEL=openrouter/free
# OPENROUTER_API_KEY=your_openrouter_key_here
# GROQ_API_KEY=your_groq_key_here
